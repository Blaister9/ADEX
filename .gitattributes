# Normalize line endings so the repository behaves identically on Windows,
# Linux and macOS agents.
* text=auto eol=lf

*.sln        text eol=crlf
*.csproj     text eol=lf
*.cs         text eol=lf
*.ts         text eol=lf
*.tsx        text eol=lf
*.json       text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.md         text eol=lf
*.py         text eol=lf
*.sql        text eol=lf
*.sh         text eol=lf

*.png        binary
*.jpg        binary
*.ico        binary
