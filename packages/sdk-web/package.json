{
  "name": "@adex/sdk-web",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-agnostic, dependency-free browser SDK for the ADEX decision API.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
