{
  "name": "adex-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "ADEX — multi-tenant adaptive decision engine. TypeScript workspace root.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "build": "pnpm -r --sequential build",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/contracts && tsc -p packages/sdk-web && tsc -p apps/dashboard",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "contracts:validate": "vitest run --project contracts",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.1",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "globals": "17.7.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
