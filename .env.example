# ---------------------------------------------------------------------------
# ADEX local development environment template.
#
# Copy to `.env` (git-ignored) and adjust. Never commit a filled-in `.env`.
# Every value here is a local development default and MUST NOT be reused in any
# shared, staging or production environment.
# ---------------------------------------------------------------------------

# --- PostgreSQL container (system of record) -------------------------------
POSTGRES_DB=adex
POSTGRES_USER=adex
POSTGRES_PASSWORD=local-dev-only-change-me
# Non-default host ports so a locally installed PostgreSQL/Redis does not clash.
POSTGRES_PORT=55432

# --- Redis container (optional acceleration, degradable) -------------------
REDIS_PORT=56379

# --- ASP.NET Core API ------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ADEX_API_HTTP_PORT=5080
# 127.0.0.1 rather than localhost on purpose: compose publishes these ports on
# the IPv4 loopback only, and on many machines `localhost` resolves to ::1 first,
# which fails to connect.
ConnectionStrings__Postgres=Host=127.0.0.1;Port=55432;Database=adex;Username=adex;Password=local-dev-only-change-me
ConnectionStrings__Redis=127.0.0.1:56379

# Persistence provider for the API. The foundation phase only ships the
# development in-memory provider; `Postgres` fails fast until the persistence
# adapters land (see docs/planning/foundation-roadmap.md).
Adex__Persistence__Provider=InMemory

# --- Anonymous identity ----------------------------------------------------
# Rotatable, environment-scoped salt used to derive first-party anonymous
# subject identifiers. Replace with a random value per environment.
Adex__Privacy__SubjectSalt=replace-with-a-random-value-per-environment

# --- Observability (OpenTelemetry) -----------------------------------------
OTEL_SERVICE_NAME=adex-api
# Leave empty to disable OTLP export and keep traces/metrics in-process.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Dashboard / SDK development -------------------------------------------
VITE_ADEX_API_BASE_URL=http://localhost:5080
